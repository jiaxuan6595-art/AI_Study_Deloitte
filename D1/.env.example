# 阿里云百炼API Key配置
# 请将下面的 sk-xxx 替换为你自己的阿里云百炼API Key
# 获取API Key地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxx

# 可选配置（如果不设置将使用默认值）
# API基础URL，默认使用阿里云百炼兼容模式地址
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认使用的模型，默认为 qwen-plus
# DEFAULT_MODEL=qwen-plus

# 请求超时时间（秒），默认为30秒
# REQUEST_TIMEOUT=30

# 最大重试次数，默认为3次
# MAX_RETRIES=3
